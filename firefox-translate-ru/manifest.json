{
  "manifest_version": 2,
  "name": "Перевод страницы на русский",
  "version": "1.0.3",
  "description": "Плавающая кнопка: переводит текст страницы на русский одним нажатием, повторное нажатие возвращает оригинал.",
  "browser_specific_settings": {
    "gecko": {
      "id": "page-translate-ru@skillex",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "storage",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "lib/providers.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/text.js",
        "content/ui.js",
        "content/main.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
